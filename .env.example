# Copy to .env and fill in your phone's values. Never commit .env.
# No phone address is hardcoded in this repo; everything device-specific
# comes from here.

# Your phone's Tailscale IP (find it in the Tailscale app on the phone).
ANDROID_PHONE_IP=
# The Termux username on the phone (check with `whoami` in Termux).
ANDROID_TERMUX_USER=
ANDROID_TERMUX_SSH_PORT=8022
ANDROID_ADB_PORT=5555
ANDROID_ADB_FORWARD_PORT=5555
ANDROID_TRANSPORT=app
# Bridge-app URL. Leave unset to derive it from ANDROID_PHONE_IP
# (http://<ANDROID_PHONE_IP>:8080).
# ANDROID_APP_URL=
# Bridge-app token, shown in the Muse Bridge app UI. Keep .env chmod 600.
# ANDROID_APP_TOKEN=
