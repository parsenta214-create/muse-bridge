<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC-UI-001: root is a ScrollView so the hint at the bottom is
     never clipped; status is four label+value rows, each value coloured
     by its state (see colors.xml). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_version"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/version_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/title_status"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_bridge_label"
                android:textColor="@color/status_neutral"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/status_bridge_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="—" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_mode_label"
                android:textColor="@color/status_neutral"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/status_mode_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="—" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_a11y_label"
                android:textColor="@color/status_neutral"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/status_a11y_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="—" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_notif_label"
                android:textColor="@color/status_neutral"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/status_notif_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="—" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/title_address"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/address_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/title_token"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/token_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textIsSelectable="true" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/token_toggle_hint"
            android:textColor="@color/status_neutral"
            android:textSize="12sp" />

        <Button
            android:id="@+id/start_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/btn_start" />
        <Button
            android:id="@+id/stop_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_stop" />
        <Button
            android:id="@+id/accessibility_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_accessibility" />
        <Button
            android:id="@+id/mode_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_mode_minimal" />
        <Button
            android:id="@+id/notification_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_notification" />
        <Button
            android:id="@+id/add_tile_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_add_tile" />
        <Button
            android:id="@+id/regenerate_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_regenerate" />
        <Button
            android:id="@+id/log_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_log" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/hint" />
    </LinearLayout>
</ScrollView>
