<!-- Globe glyph for the language-settings Quick Settings tile
     (SPEC-LOCALE-TILE-001 v2). Tile icons must be a single colour;
     white on transparent, drawn with a stroke. A circle with a
     meridian and an equator, so it reads as a globe at tile size
     and stays distinct from the power glyph of ic_tile. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M12,12m-9,0a9,9 0 1,0 18,0a9,9 0 1,0 -18,0" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M12,3 A4.5,9 0 1,0 12,21 A4.5,9 0 1,0 12,3" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M3,12 L21,12" />
</vector>
