<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- SPEC-UI-001: text colours are mapped to status information.
         Green = OK, red = needs action, amber = deliberate restriction,
         grey = neutral. Colour never carries information alone — the
         status word is always shown as text too. -->
    <color name="status_ok">#2E7D32</color>
    <color name="status_bad">#C62828</color>
    <color name="status_warn">#EF6C00</color>
    <color name="status_neutral">#757575</color>
    <!-- SPEC-UI-001 v2.6.2 (GPT CONS-047 P1): disabled buttons keep a
         readable medium-grey text instead of fading away. -->
    <color name="button_disabled_text">#616161</color>
</resources>
